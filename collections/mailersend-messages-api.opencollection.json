{
  "opencollection": "1.0.0",
  "info": {
    "name": "MailerSend Bulk Email Messages API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mailersend.com/v1/messages"
          },
          "docs": "List messages"
        },
        {
          "info": {
            "name": "Get a message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mailersend.com/v1/messages/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a message"
        }
      ]
    }
  ],
  "bundled": true
}